{
  "version": 2,
  "builds": [
    {
      "src": "**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*.ts",
      "use": "@vercel/node",
      "options": {
        "tsconfig": "tsconfig.json"
      }
    },
    {
      "src": "**/*.tsx",
      "use": "@vercel/node",
      "options": {
        "tsconfig": "tsconfig.json"
      }
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/contact",
      "dest": "/api/contact/route"
    },
    {
      "src": "/(.*)",
      "dest": "/_next/static/chunks/pages/$1",
      "skip_files": [
        "api",
        "_next",
        "favicon.ico",
        "sitemap.xml",
        "robots.txt"
      ]
    }
  ]
}